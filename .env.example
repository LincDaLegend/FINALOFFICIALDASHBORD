# eBay — required for search (developer.ebay.com/my/keys → Production)
EBAY_APP_ID=
EBAY_CLIENT_SECRET=

# Sold prices — RapidAPI "eBay Average Selling Price" key (see README)
RAPIDAPI_KEY=

# Optional — only for connecting your eBay account (RuName) and the OAuth return URL
EBAY_REDIRECT_URI=
NEXT_PUBLIC_APP_URL=

# Optional — AI helpers
ANTHROPIC_API_KEY=
