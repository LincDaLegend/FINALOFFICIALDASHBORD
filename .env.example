# eBay — required for search (developer.ebay.com/my/keys → Production)
EBAY_APP_ID=
EBAY_CLIENT_SECRET=

# Sold prices — RapidAPI "eBay Average Selling Price" key (see README)
RAPIDAPI_KEY=

# Optional — AI helpers
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional: Google Routes API key (server only) for traffic-aware drive times in the Cebu Trip tab
GOOGLE_MAPS_API_KEY=
# Optional: Google Maps browser key (Maps JavaScript API, restricted to the site address) for the trip map
GOOGLE_MAPS_BROWSER_KEY=
# Optional: Google Cloud map ID (vector map); DEMO_MAP_ID is used when empty
GOOGLE_MAP_ID=
